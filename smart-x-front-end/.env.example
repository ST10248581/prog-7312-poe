# Copy to .env.local (git-ignored) to override for your machine, or to
# .env.production for a deployed build.
#
# Base URL of the Smart-X API, including the /api prefix.
VITE_API_BASE_URL=http://localhost:5127/api

# Milliseconds before a request is abandoned (optional; default 10000).
# VITE_API_TIMEOUT_MS=10000
